# Copy file ini jadi ".env" lalu isi semua nilainya. JANGAN upload .env ke publik/GitHub.

# Kunci rahasia untuk LOGIN ke dashboard Vanz (yang kamu ketik di halaman login web).
# Bebas, buat sendiri, makin panjang & acak makin aman. Contoh: buka-vanz-rahasia-2026-xyz
ADMIN_SECRET_KEY=buka-vanz-rahasia-2026-xyz

# Kunci rahasia untuk otentikasi BOT ke API Vanz (dipakai bot developer saat minta generate license,
# dan dipakai bot buyer saat validasi aktivasi). Beda dengan ADMIN_SECRET_KEY di atas.
BOT_API_KEY=vanzky_bot_8xKp92LmQ4wN7rT5

# Kunci untuk enkripsi session login di browser. Bebas, string acak panjang.
SESSION_SECRET=Vx9KmP2@qL7!Nz4^Yt6&Fb3*Hs5_Jd1+Ac0=Ep9%Gu2

# Port server akan jalan (Railway/Render biasanya auto-set PORT sendiri, port di bawah cuma fallback lokal)
PORT=3000
